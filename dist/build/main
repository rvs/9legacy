#!/bin/rc

rfork en

. funcs

task=( \
	prepare \
	mod \
	build \
	checkbuild \
	bootdisk \
	repl \
	iso \
	copy \
)

# usb: add usb and copy-usb after iso and send

if(! test -d log)
	mkdir log
if not
	rm -f log/*

echo target is $target

for(i in $task){
	echo -n $i'... '
	$i >log/$i >[2=1]
	if(~ $status '')
		echo done
	if not{
		echo failed
		exit failed
	}
}
